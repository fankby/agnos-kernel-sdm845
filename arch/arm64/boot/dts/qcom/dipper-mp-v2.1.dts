/dts-v1/;

#include "sdm845-v2.1.dtsi"
#include "sdm845-sde-display.dtsi"
#include "dipper-mp-pinctrl.dtsi"
#include "dipper-mp.dtsi"
#include "dipper-audio-overlay.dtsi"

/ {
	model = "comma tizi";
	compatible = "qcom,sdm845-mtp", "qcom,sdm845", "qcom,mtp";
	qcom,board-id = <55 0>;
	qcom,dipper-agnos-imu-compat;
};

/* AGNOS userspace reads comma,gpio-som-id to choose display/touch origin.
 * Xiaomi Dipper has no C3/Tizi SOM-ID GPIO straps, so provide a fixed ID in
 * the board DTB instead of patching rootfs.
 */
&vendor {
	gpio-som-id {
		status = "okay";
		compatible = "comma,gpio-som-id";
		comma,fixed-som-id = <0>;
	};
};

/* Dipper does not need USB-PD for AGNOS/openpilot. Let SMB2's charger/type-C
 * extcon own both peripheral VBUS and host ID events so PD error recovery
 * cannot hard-disconnect an active ADB/Panda session.
 */
&pmi8998_charger {
	qcom,use-extcon;
};

&pmi8998_pdphy {
	status = "disabled";
};

&usb0 {
	extcon = <&pmi8998_charger>, <&pmi8998_charger>, <&eud>;
};

&usb0 {
	dwc3@a600000 {
		/*
		 * Dipper's USB2 gadget link can enter L1/SLEEP shortly after
		 * configuration and then fail the DWC3 recovery path, dropping
		 * ADB/Panda back to default/full-speed. Keep HS sessions out of
		 * USB2 LPM instead of relying on userspace to rebind the gadget.
		 */
		snps,usb2-l1-disable;
		snps,dis_u2_susphy_quirk;
	};
};

/*
 * Xiaomi's SE6 HS-UART shows up as /dev/ttyHS0. AGNOS/openpilot tizi branches
 * treat that path as the comma ublox/GNSS modem UART, which Dipper does not
 * have. Keep the real Xiaomi hardware out of the tizi GNSS path.
 */
&qupv3_se6_4uart {
	status = "disabled";
};
